# Generated by install.sh from slop-sniper.service.template; edit the template, not the installed copy.
[Unit]
Description=slop-sniper - Discord slop and scam image checker
After=network-online.target
Wants=network-online.target

[Service]
# The bot tells systemd when it has started, so "systemctl restart" waits for it.
Type=notify
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/SlopSniper

# When the CPU is busy, SoftEther and FaustBot (default weight 100) get 5x the share of this service,
# OCR included. When it's idle, OCR still runs at full speed.
CPUWeight=20

# Restart after a crash, but not after a config error (exit 78).
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
